# Copy to .env for local work. On Render, add these in Environment (never commit real keys).
DEBUG=0
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=voice-agent-project.onrender.com
CSRF_TRUSTED_ORIGINS=https://voice-agent-project.onrender.com

# Database (Neon/Supabase Postgres). Empty = local SQLite (data is lost on Render free)
DATABASE_URL=

CLINIC_NAME=Demo Clinic
CLINIC_TZ=Asia/Karachi
EMERGENCY_NUMBER=1122
REMINDER_REPEAT_MINUTES=2
TASK_LEAD_MINUTES=30

# LLM (fallback order, left to right) - use model names that work on your key today
GROQ_API_KEY=
LLM_CHAIN=groq:openai/gpt-oss-120b,groq:qwen/qwen3.6-27b
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# Speech
STT_ENGINE=groq
STT_LANGUAGE=en
TTS_ENGINE=browser

# Google Calendar: key file as base64 (one line). Empty = events stay local
GOOGLE_SERVICE_ACCOUNT_JSON=
